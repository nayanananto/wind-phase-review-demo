# Optional: leave empty for the deterministic, API-key-free demo.
OPENAI_API_KEY=
SEMANTIC_LLM_MODEL=gpt-4o-mini
WIND_DATA_MODE=snapshot
PORT=7860
WIND_HOST=0.0.0.0
WIND_RUNTIME_DIR=runtime
# Generate this locally; set it as a hosting secret to preserve signed sessions.
WIND_SESSION_SECRET=
WIND_REQUESTS_PER_MINUTE=20
# Maximum LLM-enabled requests per UTC day, per running instance.
# One request may make more than one model call. This is not a billing cap.
WIND_LLM_REQUESTS_PER_DAY=30
# Set to 1 on the HTTPS host; keep 0 for local HTTP testing.
WIND_SECURE_COOKIES=0
